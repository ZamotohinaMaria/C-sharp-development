@page "/requests"
@using System.Globalization;
@inject HttpClient Http

<PageTitle>Requests</PageTitle>

<h1>Requests</h1>

<div class="task-container">
    <h5>Вывести сведения о всех авиарейсах, вылетевших из указанного пункта отправления в указанный пункт прибытия.</h5>
    <label for="departurePoint">Введите пункт отправления:</label>
    <select id="departurePoint" @bind="departurePoint">
        @foreach(var flight in _airFlights)
        {
            <option>@flight.DeparturePoint</option>
        }
    </select>
    <label for="arrivePoint">Введите пункт прибытия:</label>
    <select id="arrivePoint" @bind="arrivePoint">
        @foreach (var flight in _airFlights)
        {
            <option>@flight.ArrivalPoint</option>
        }
    </select>
    <div class="button-container">
        <Button class="get-task-result" Color="Blazorise.Color.Primary" Clicked="@(() => ClickHandler(1))">
            Получить результат
        </Button>
        <Button class="clear-task-result" Color="Blazorise.Color.Danger" Clicked="@(() => ClearTask(1))">
            Очистить
        </Button>
    </div>

    @if(request1 != null)
    {
        <div class="result-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Номер рейса</th>
                        <th>Пункт отправления</th>
                        <th>Пункт прибытия</th>
                        <th>Дата отправления</th>
                        <th>Дата прибытия</th>
                        <th>Время в пути</th>
                        <th>Тип самолета</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var flight in request1)
                    {
                        <tr>
                            <td>@(flight.IdFlight)</td>
                            <td>@(flight.CodeNumber)</td>
                            <td>@flight.DeparturePoint</td>
                            <td>@flight.ArrivalPoint</td>
                            <td>@flight.Departure</td>
                            <td>@flight.Arrive</td>
                            <td>@flight.FlyingTime.ToLongTimeString()</td>
                            <td>@flight.Plane.Model</td>
                    
                        </tr>
                    }
                </tbody>
            </table>
        </div>;
    }
    @if (request1 == null)
    {
        <div>Поданному запросу результатов нет</div>
    }
</div>
<div class="task-container">
    <h5>
        Вывести сведения обо всех пассажирах, летящих данным рейсом, вес багажа которых равен нулю, упорядочить по ФИО.
    </h5>
    <label for="idFlight">Выберете рейс:</label>
    <select id="idFlight" @bind="idFlight">
        @foreach (var flight in _airFlights)
        {
            <option>@flight.IdFlight</option>
        }
    </select>
    <p class="form-control" style="border: none">Номер рейса: @GetFlightCodeNumber(idFlight)</p>
    <p class="form-control" style="border: none">Отправление: @GetFlightDeparturePoint(idFlight) -> @GetFlightDeparture(idFlight)</p>
    <p class="form-control" style="border: none">Прибытие:  @GetFlightArrivePoint(idFlight) -> @GetFlightArrive(idFlight)</p>
    <div class="button-container">
        <Button class="get-task-result" Color="Blazorise.Color.Primary" Clicked="@(() => ClickHandler(2))">
            Получить результат
        </Button>
        <Button class="clear-task-result" Color="Blazorise.Color.Danger" Clicked="@(() => ClearTask(2))">
            Очистить
        </Button>
    </div>

    @if (request2 != null)
    {
        <div class="result-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Фио</th>
                        <th>Номер пасспорта</th>
                        <th>Номер билета</th>
                        <th>Номер места</th>
                        <th>Вес багажа</th>
                        <th>Номер рейса</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var pass in request2)
                    {
                        <tr>
                            <td>@(pass.IdPassenger)</td>
                            <td>@pass.FullName</td>
                            <td>@pass.Passport</td>
                            <td>@pass.TicketNumber</td>
                            <td>@pass.SeatNumber</td>
                            <td>@pass.BaggageWeight</td>
                            <td>@pass.IdFlight</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (request2 == null)
    {
        <div>Поданному запросу результатов нет</div>
    }
</div>
<div class="task-container">
    <h5>
        Вывести сводную информацию обо всех полетах самолетов данного типа в указанный период времени.
    </h5>
    <label for="idFlight">Выберете модель самолета:</label>
    <select id="planeModel" @bind="planeModel">
        @foreach (var plane in _planes)
        {
            <option>@plane.Model</option>
        }
    </select>
    <label>Дата отправления: </label>
    <input type="datetime" id="departure" @bind="departure" />
    <label>Дата прибытия: </label>
    <input type="datetime" id="arrive" @bind="arrive" />
