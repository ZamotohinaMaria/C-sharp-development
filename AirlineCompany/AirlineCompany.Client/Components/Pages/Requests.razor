@code {
    private List<AirFlight> _airFlights = new();
    private List<Passeneger> _passengers = new();
    private List<Plane> _planes = new();

    private Modal? _modalRef = null!;

    private string passengerUrl = "api/Passenger";
    private string flightUrl = "api/AirFlight";
    private string planeUrl = "api/Plane";




    private List<AirFlight> request1 = null!;
    private List<Passeneger> request2 = null!;
    private List<AirFlight> request3 = null!;
    private List<AirFlightNumberPassangers> request4 = null!;
    private List<AirFlight> request5 = null!;
    private List<double> request6 = null!;

    private string _errorMessage = "";

    private async Task LoadAirFlights()
    {
        var responseFlight = await Http.GetFromJsonAsync<List<AirFlight>>(flightUrl);
        if (responseFlight != null)
        {
            _airFlights = responseFlight;
        }
    }

    private async Task LoadPassengers()
    {
        var responsePassenger = await Http.GetFromJsonAsync<List<Passeneger>>(passengerUrl);
        if (responsePassenger != null)
        {
            _passengers = responsePassenger;
        }
    }

    private async Task LoadPlanes()
    {
        var responsePlane = await Http.GetFromJsonAsync<List<Plane>>(planeUrl);
        if (responsePlane != null)
        {
            _planes = responsePlane;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAirFlights();
        await LoadPassengers();
        await LoadPlanes();
    }

    private string departurePoint = "";
    private string departurePoint2 = "";
    private string arrivePoint =  "";
    private int idFlight = 1;
    private string planeModel = "";
    private DateTime departure = new DateTime(2024, 1, 1);
    private DateTime arrive = new DateTime(2025, 1, 1);

    private async Task ClickHandler(int taskId)
    {
        switch (taskId)
        {
            case 1:
                // departurePoint = GetFlightDeparturePoint(1);
                // arrivePoint = GetFlightArrivePoint(1);

                var response1 = await Http.GetFromJsonAsync<List<AirFlight>>("api/Request/FirstTask?departure=" + departurePoint + "&arrive=" + arrivePoint);
                if (response1 != null)
                {
                    request1 = response1;
                }
                break;
            case 2:
                var response2 = await Http.GetFromJsonAsync<List<Passeneger>>("api/Request/SecondTask?idFlight=" + idFlight);
                if (response2 != null)
                {
                    request2 = response2;
                }
                break;
            case 3:
                //planeModel = GetPlaneModel(1);
                var response3 = await Http.GetFromJsonAsync<List<AirFlight>>("api/Request/ThirdTask?planeModel=" + planeModel + "&departure=" + departure + "&arrive=" + arrive);
                if (response3 != null)
                {
                    request3 = response3;
                }
                break;
            case 4:
                var response4 = await Http.GetFromJsonAsync<List<AirFlightNumberPassangers>>("api/Request/FourthTask");
                if (response4 != null)
                {
                    request4 = response4;
                }
                break;
            case 5:
                var response5 = await Http.GetFromJsonAsync<List<AirFlight>>("api/Request/FifthTask");
                if (response5 != null)
                {
                    request5 = response5;
                }
                break;
            case 6:
                //departurePoint2 = GetFlightDeparturePoint(1);

                var response6 = await Http.GetFromJsonAsync<List<double>>("api/Request/SixthTask?departure=" + departurePoint2);
                if (response6 != null)
                {
                    request6 = response6;
                }
                break;
        }
    }

    private void ClearTask(int taskId)
    {
        switch (taskId)
        {
            case 1:
                request1 = null!;
                break;
            case 2:
                request2 = null!;
                break;
            case 3:
                request3 = null!;
                break;
            case 4:
                request4 = null!;
                break;
            case 5:
                request5 = null!;
                break;
            case 6:
                request6 = null!;
                break;
        }
    }

    private string GetFlightCodeNumber(int flightId) => _airFlights?.FirstOrDefault(f => f.IdFlight == flightId)?.CodeNumber!;
    private string GetFlightDeparturePoint(int flightId) => _airFlights?.FirstOrDefault(f => f.IdFlight == flightId)?.DeparturePoint!;
    private DateTime? GetFlightDeparture(int flightId) => _airFlights?.FirstOrDefault(f => f.IdFlight == flightId)?.Departure!;
    private string GetFlightArrivePoint(int flightId) => _airFlights?.FirstOrDefault(f => f.IdFlight == flightId)?.ArrivalPoint!;
    private DateTime? GetFlightArrive(int flightId) => _airFlights?.FirstOrDefault(f => f.IdFlight == flightId)?.Arrive!;

    private string GetPlaneModel(int planeId) => _planes?.FirstOrDefault(p => p.IdPlane == planeId)?.Model!;


    private async Task CancelHandler()
    {
        await _modalRef!.Hide();
        _errorMessage = "";
    }
}