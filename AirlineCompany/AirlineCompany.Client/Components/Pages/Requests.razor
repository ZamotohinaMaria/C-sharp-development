<div class="task-container">
    <h5>
        Вывести информацию о средней и максимальной загрузке авиарейсов из заданного пункта отправления.
    </h5>
    <label for="departurePoint2">Введите пункт отправления:</label>
    <select id="departurePoint2" @bind="departurePoint2">
        @foreach (var flight in _airFlights)
        {
            <option>@flight.DeparturePoint</option>
        }
    </select>
    <div class="button-container">
        <Button class="get-task-result" Color="Blazorise.Color.Primary" Clicked="@(() => ClickHandler(6))">
            Получить результат
