@page "/"
@using System.Globalization;
@inject HttpClient Http

<PageTitle>AirFlights</PageTitle>

<h1>AirFlights</h1>

<p>Список полетов.</p>

<Button class="add-new-button" Clicked="@ShowAdd" Color="Blazorise.Color.Primary">
    Добавить Полет
</Button>

<table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Номер рейса</th>
                <th>Пункт отправления</th>
                <th>Пункт прибытия</th>
                <th>Дата отправления</th>
                <th>Дата прибытия</th>
                <th>Время в пути</th>
                <th>Тип самолета</th>
            </tr>
        </thead>

    <tbody>
        @foreach (var flight in _airFlights)
        {
            <tr>
                <td>@(flight.IdFlight)</td>
                <td>@(flight.CodeNumber)</td>
                <td>@flight.DeparturePoint</td>
                <td>@flight.ArrivalPoint</td>
                <td>@flight.Departure</td>
                <td>@flight.Arrive</td>
                <td>@flight.FlyingTime.ToLongTimeString()</td>
                <td>@flight.Plane.Model</td>
                <td>
                    <Button Color="Blazorise.Color.Primary"
                            class="edit-item"
                            @onclick="@(() => ShowUpdate(flight.IdFlight))"
                            Style="max-width: 89px"
                            TextAlignment="TextAlignment.Center">
                        UPDATE
                    </Button>
                </td>
                <td>
                    <Button Color="Blazorise.Color.Danger"
                            class="edit-item"
                            @onclick="@(() => DeleteItem(flight.IdFlight))"
                            Style="max-width: 89px"
                            TextAlignment="TextAlignment.Center">
                        DELETE
                    </Button>
                </td>
            </tr>
        }
    </tbody>
</table>

<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader>
            <h5>Добавить полет</h5>
        </ModalHeader>
        <ModalBody>
            <div class="mb-3">
                <label for="codeNumber">Номер рейса</label>
                <input type="text" id="codeNumber" @bind="newAirFlifgt.CodeNumber" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="departurePoint">Пункт отправления</label>
                <input type="text" id="departurePoint" @bind="newAirFlifgt.DeparturePoint" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="arrivalPoint">Пункт прибытия</label>
                <input type="text" id="arrivalPoint" @bind="newAirFlifgt.ArrivalPoint" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="departure">Время отправления</label>
                <input type="datetime" id="departure" @bind="newAirFlifgt.Departure" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="arrival">Время прибытия</label>
                <input type="datetime" id="arrival" @bind="newAirFlifgt.Arrive" class="form-control" />
            </div>
            <div class="mb-3">
			    <select id="plane" @bind="newAirFlifgt.PlaneId">
                    @foreach (var plane in _planes)
                    {
                        <option>@plane.IdPlane</option>
                    }
			    </select>
                <p class="form-control" style="border: none">@GetPlaneModel(newAirFlifgt.PlaneId)</p>
            </div>
        </ModalBody>

        <ModalFooter>
            <Button Color="Blazorise.Color.Primary" Clicked="@(forAdd ? AddNewItem : UpdateItem)">
                @(forAdd ? "Добавить" : "Изменить")
            </Button>
            <Button Color="Blazorise.Color.Secondary" Clicked="@CancelHandler">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>


@code {
    private List<AirFlight> _airFlights = new();
    private List<Plane> _planes = new();

    private Modal? modalRef = null!;
    private AirFlight newAirFlifgt = new()
        {
            IdFlight = 0,
            CodeNumber = "N000",
            DeparturePoint = "",
            ArrivalPoint = "",
            Departure = DateTime.Now,
            Arrive = DateTime.Now,
            FlyingTime = TimeOnly.Parse("00:00:00"),
            PlaneId = 0,
            Plane = null
        };
    private bool forAdd = true;
    private string flightUrl = "api/AirFlight";
    private string planeUrl = "api/Plane";
    
    private async Task LoadPlanes()
    {
        var responsePlane = await Http.GetFromJsonAsync<List<Plane>>(planeUrl);
        if (responsePlane != null)
        {
            _planes = responsePlane;
        }
    }

    private async Task UpdateMainList()
    {
        var responseFlight = await Http.GetFromJsonAsync<List<AirFlight>>(flightUrl);
        if (responseFlight != null)
        {
            _airFlights = responseFlight;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await UpdateMainList();
        await LoadPlanes();
    }

    private async Task ShowUpdate(int flightId)
    {
        forAdd = false;
        var response = await Http.GetFromJsonAsync<AirFlight>($"{flightUrl}/{flightId}");
        if (response != null)
        {
            newAirFlifgt = response;
        }
        await modalRef!.Show();
    }
    
    private async Task ShowAdd()
    {
        forAdd = true;
        newAirFlifgt = new()
            {
                IdFlight = 0,
                CodeNumber = "N000",
                DeparturePoint = "",
                ArrivalPoint = "",
                Departure = DateTime.Now,
                Arrive = DateTime.Now,
                FlyingTime = TimeOnly.Parse("00:00:00"),
                PlaneId = 0,
                Plane = null
            }; 
        await UpdateMainList();
        await modalRef!.Show();
    }


    
    private async Task CancelHandler()
    {
        await modalRef!.Hide();
    }

    private async Task AddNewItem()
    {
        await Http.PostAsJsonAsync<AirFlight>(flightUrl, newAirFlifgt);
        await UpdateMainList();
        await modalRef!.Hide();
    }

    private async Task UpdateItem()
    {
        await Http.PutAsJsonAsync($"{flightUrl}/{newAirFlifgt.IdFlight}", newAirFlifgt);

        newAirFlifgt = new()
            {
                IdFlight = 0,
                CodeNumber = "N000",
                DeparturePoint = "",
                ArrivalPoint = "",
                Departure = DateTime.Now,
                Arrive = DateTime.Now,
                FlyingTime = TimeOnly.Parse("00:00:00"),
                PlaneId = 0,
                Plane = null
            }; 
        await UpdateMainList();
        await modalRef!.Hide();
    }

    private async Task DeleteItem(int flightId)
    {
        await Http.DeleteAsync($"{flightUrl}/{flightId}");
        await UpdateMainList();
    }

    private string GetPlaneModel(int planeId) => _planes?.FirstOrDefault(p => p.IdPlane == planeId)?.Model!;
}
