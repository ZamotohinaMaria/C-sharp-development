@page "/planes"
@inject HttpClient Http

<PageTitle>Planes</PageTitle>

<h1>Planes</h1>

<p>Список самолетов.</p>

<Button class="add-new-button" Clicked="@ShowAdd" Color="Blazorise.Color.Primary">
    Добавить Самолет
</Button>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Модель</th>
            <th>Грузоподъемность</th>
            <th>Производительность</th>
            <th>Макс. число пассажиров</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var plane in _planes)
        {
            <tr>
                <td>@(plane.IdPlane)</td>
                <td>@plane.Model</td>
                <td>@plane.LoadCapacity</td>
                <td>@plane.Efficiency</td>
                <td>@plane.PassengerMax</td>
                <td>
                    <Button Color="Blazorise.Color.Primary"
                            class="edit-item"
                            @onclick="@(() => ShowUpdate(plane.IdPlane))"
                            Style="max-width: 89px"
                            TextAlignment="TextAlignment.Center">
                        UPDATE
                    </Button>
                </td>
                <td>
                    <Button Color="Blazorise.Color.Danger"
                            class="edit-item"
                            @onclick="@(() => DeleteItem(plane.IdPlane))"
                            Style="max-width: 89px"
                            TextAlignment="TextAlignment.Center">
                        DELETE
                    </Button>
                </td>
            </tr>
        }
    </tbody>
</table>

<Modal @ref="modalRef">
    <ModalContent Centered>
        <ModalHeader>
            <h5>Добавить пассажира</h5>
        </ModalHeader>
        <ModalBody>
            <div class="mb-3">
                <label for="model">Модель</label>
                <input type="text" id="model" @bind="newPlane.Model" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="loadCapacity">Грузоподъемность</label>
                <input type="double" id="loadCapacity" @bind="newPlane.LoadCapacity" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="efficiency">Производительность</label>
                <input type="double" id="efficiency" @bind="newPlane.Efficiency" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="passengerMax">Максимальное число пассажиров</label>
                <input type="int" id="passengerMax" @bind="newPlane.PassengerMax" class="form-control" />
            </div>
            @*<select id="plane" @bind="newPlane.Plane.IdPlane">
            @foreach (var plane in _planes)
            {
            <option value="@plane.IdPlane">@plane.IdPlane @plane.Model</option>
            }
            </select>*@
        </ModalBody>

        <ModalFooter>
            <Button Color="Blazorise.Color.Primary" Clicked="@(forAdd ? AddNewItem : UpdateItem)">
                @(forAdd ? "Добавить" : "Изменить")
            </Button>
            <Button Color="Blazorise.Color.Secondary" Clicked="@CancelHandler">
                Отмена
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>


@code {
    private List<Plane> _planes = new();

    private Modal? modalRef = null!;
    private Plane newPlane = new()
        {
            IdPlane = 0,
            Model = "M-0000",
            LoadCapacity = 0,
            Efficiency = 0,
            PassengerMax = 0
        };
    private bool forAdd = true;
    private string planeUrl = "api/Plane";

    private async Task UpdateMainList()
    {
        var response = await Http.GetFromJsonAsync<List<Plane>>(planeUrl);
        if (response != null)
        {
            _planes = response;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await UpdateMainList();
    }

    private async Task ShowUpdate(int planeId)
    {
        forAdd = false;
        var response = await Http.GetFromJsonAsync<Plane>($"{planeUrl}/{newPlane}");
        if (response != null)
        {
            newPlane = response;
        }
        await modalRef!.Show();
    }

    private async Task ShowAdd()
    {
        forAdd = true;
        newPlane = new()
            {
                IdPlane = 0,
                Model = "M-0000",
                LoadCapacity = 0,
                Efficiency = 0,
                PassengerMax = 0
            };
        await UpdateMainList();
        await modalRef!.Show();
    }



    private async Task CancelHandler()
    {
        await modalRef!.Hide();
    }

    private async Task AddNewItem()
    {
        await Http.PostAsJsonAsync<Plane>(planeUrl, newPlane);
        await UpdateMainList();
        await modalRef!.Hide();
    }

    private async Task UpdateItem()
    {
        await Http.PutAsJsonAsync($"{planeUrl}/{newPlane.IdPlane}", newPlane);

        newPlane = new()
            {
                IdPlane = 0,
            Model = "M-0000",
            LoadCapacity = 0,
            Efficiency = 0,
            PassengerMax = 0
            };
        await UpdateMainList();
        await modalRef!.Hide();
    }

    private async Task DeleteItem(int newPlane)
    {
        await Http.DeleteAsync($"{planeUrl}/{newPlane}");
        await UpdateMainList();
    }
}
